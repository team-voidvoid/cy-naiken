# Configure secrets server-side only. Never use NEXT_PUBLIC_ or commit real values.
# Hosted Sites: set these through the Sites runtime environment settings.
# Local Cloudflare preview: put values in an ignored .env or .dev.vars file.
OPENAI_API_KEY=
NAIKEN_AGENT_MODEL=gpt-6.1-sol
# Decisions API scoring is available with the server key. Set false to disable.
# The Decisions model is gpt-6-luna, independently of NAIKEN_AGENT_MODEL.
NAIKEN_DECISIONS_ENABLED=true
# Cheap version fallback: gpt-6-luna, one short request per scan, cached for 7 days.
# Disable paid version extraction while retaining local pattern extraction.
NAIKEN_VERSION_EXTRACTION_ENABLED=true
